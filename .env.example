# AI API Key (Required)
AI_BAILIAN_API_KEY=your_api_key_here

# AI Model (Optional, default: qwen-plus)
# AI_MODEL=qwen-max
# Structured output retries (Optional, default: 2)
# APP_AI_STRUCTURED_MAX_ATTEMPTS=2
# Include last parser error in retry prompt (Optional, default: true)
# APP_AI_STRUCTURED_INCLUDE_LAST_ERROR=true

# Optional: Override defaults
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=interview_guide

# Dify 知识库集成 (Optional, 用于知识库同步到 Dify 平台)
# Dify Cloud 地址: https://api.dify.ai/v1，自建: http://your-host/v1
# DIFY_API_URL=https://api.dify.ai/v1
# Dify 知识库 API Key (格式: dataset-xxx，在 Dify 知识库设置页获取)
# DIFY_API_KEY=dataset-xxxxxxxxxx
# Dify 知识库 ID (UUID 格式，从知识库页面 URL 获取)
# DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
